# macOS
.DS_Store

# Whisper model binaries (547MB — re-download, never commit)
.models/
apps/OrbitApp/Vendor/

# Personal voice recordings stay local; transcripts are tracked
mock_memos/*.m4a

# Local tooling
.claude/settings.local.json

# Swift / SPM
.build/
.swiftpm/
DerivedData/
*.xcodeproj

# Local-only artifacts
/audio-fixtures/
.env

# Generated by scripts/build-whisper.sh — local overlay spec, Mac-only
apps/OrbitApp/project-whisper.yml

# Live extraction fixtures (docs/evals/fixtures/live-<model>/). Deliberately not
# tracked: consecutive runs of the SAME prompt against the same corpus differ by
# enough to flip round-trip checks, so any one snapshot implies a stability the
# output does not have. The measurement reports carry the numbers and the spread.
docs/evals/fixtures/live-*/

# Raw collected runs. The per-run fixtures are the re-gradable evidence store
# (MEASUREMENT-REWORK: collection is separate from grading), but k=10 over the
# corpus is ~110 files that change every job. The aggregate report and the
# manifest are the durable artifacts and stay tracked.
docs/evals/runs/*/run-*/

__pycache__/
*.pyc

# Judge verdicts, cached by (transcript, claim, judge model, prompt version).
# Regenerable and billable-once; not worth versioning, but deleting it costs
# real money to rebuild.
docs/evals/judge-cache/

# Audit answers land in the project root from the browser's download. The
# canonical copy lives beside its key in docs/evals/runs/<label>/.
/judge-audit-answers.json
